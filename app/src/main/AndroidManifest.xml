<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for the WebView to load remote URLs (PRD §5) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- COK-26: native notifications for inbound monitor alerts (runtime-requested on 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- COK-26: persisted JobScheduler jobs only re-materialize after a reboot with this -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Backup disabled (COK-25): the bookmark and share-template preferences are
         credential-adjacent (a template can embed token text; bookmarks name private
         services) and must not ride adb/cloud backups. Everything is re-creatable. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CookiesExtractor"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.CookiesExtractor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- COK-26: periodic poll of the gateway state document -->
        <service
            android:name=".MonitorJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
