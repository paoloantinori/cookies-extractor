<?xml version="1.0" encoding="utf-8"?>
<!-- COK-1.4: FrameLayout root so the FAB overlays the WebView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top navigation bar: URL field + Go button (PRD §3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <EditText
                android:id="@+id/url_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/url_hint"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:maxLines="1" />

            <!-- COK-28: compact borderless Go. The Material default ate ~88dp of width for
                 two letters; minWidth=0 with side padding keeps it narrow, while minHeight
                 stays 48dp so the touch target fills the row (set by the taller URL field)
                 instead of collapsing to the text line. -->
            <Button
                android:id="@+id/go_button"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/go" />

            <!-- COK-27: low-frequency actions behind one overflow menu -->
            <ImageButton
                android:id="@+id/overflow_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/overflow_btn_cd"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:src="@android:drawable/ic_menu_more" />
        </LinearLayout>

        <!-- COK-41: persistent capture banner. A captured redirect never renders a
             page, so this (with the morphed FAB) is the durable "something happened"
             surface; it names the source host only, never the code. -->
        <LinearLayout
            android:id="@+id/capture_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/capture_banner_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/capture_banner_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                tools:text="Code captured from login.microsoftonline.com" />

            <Button
                android:id="@+id/capture_banner_share"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/capture_notice_share"
                android:textColor="#FFFFFF" />

            <ImageButton
                android:id="@+id/capture_banner_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/capture_banner_dismiss_cd"
                android:minWidth="40dp"
                android:minHeight="40dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Main content: WebView fills all remaining space (PRD §3) -->
        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Action element: FAB anchored bottom-right. Cookie share by default; while a
         capture is held MainActivity morphs it into the code share (COK-41). -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/share_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/share_cd"
        app:srcCompat="@android:drawable/ic_menu_share" />

</FrameLayout>
